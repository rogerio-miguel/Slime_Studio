# Slime Studio — variáveis de ambiente
# Copie para .env e preencha. .env nunca deve ser commitado (ver .gitignore).

# Token fixo único para o painel admin (decisão da seção 10.1 do documento de
# especificação: gerado uma vez, comparado num cookie/header — sem login completo).
ADMIN_ACCESS_TOKEN=

# Paths de mídia (seção 10.1) — raiz onde ficam raw/, frames/ e hls/{anime_id}/{episodio_id}/
MEDIA_ROOT=./media

# Banco de dados (seção 4 — SQLite em modo WAL)
DATABASE_URL=sqlite:///./backend/db/slime_studio.db

# Tile size default para o realesrgan-ncnn-vulkan (seção 3C — evita estouro de VRAM na RX 580).
# Ajustar com base nos resultados do PoC da Fase 0.
UPSCALE_TILE_SIZE=200

# Credenciais/IDs para integrações de metadados (seção 3F)
ANILIST_API_URL=https://graphql.anilist.co
KITSU_API_URL=https://kitsu.io/api/edge
