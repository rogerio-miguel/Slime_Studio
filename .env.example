# Slime Studio — variáveis de ambiente
# Copie para .env e preencha. .env nunca deve ser commitado (ver .gitignore).

# Paths de mídia (seção 10.1) — raiz onde ficam raw/ e hls/{anime_slug}/{numero}/.
# Fica no mount NTFS (é onde há espaço — seção 6); nunca usado para o banco ou o scratch.
MEDIA_ROOT=./media

# Scratch de frames em voo por chunk (seção 3C, B2) — precisa ficar em ext4 ou tmpfs,
# nunca no mount NTFS (ntfs-3g não garante rename atômico nem aguenta o churn de I/O).
SCRATCH_ROOT=/tmp/slime-studio-scratch

# Banco de dados (seção 4 — SQLite em modo WAL, driver assíncrono). Precisa ficar em
# ext4: WAL depende de shared-memory mapping e locks POSIX que ntfs-3g/FUSE só emula
# (seção 6, B1) — nunca apontar isso pro mesmo mount de MEDIA_ROOT.
# ATENÇÃO: "~" não é expandido por SQLAlchemy/sqlite3 — use sempre o path absoluto
# real do seu $HOME (4 barras após "sqlite+aiosqlite://"), como no exemplo abaixo.
DATABASE_URL=sqlite+aiosqlite:////home/rogerio/.local/share/slime-studio/slime_studio.db

# Tile size default para o realesrgan-ncnn-vulkan (seção 3C — evita estouro de VRAM na RX 580).
# Ajustar com base nos resultados do PoC da Fase 0.
UPSCALE_TILE_SIZE=200

# Credenciais/IDs para integrações de metadados (seção 3F)
ANILIST_API_URL=https://graphql.anilist.co
KITSU_API_URL=https://kitsu.io/api/edge
