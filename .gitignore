CONTEXT_NEXT.md
.claude/settings.local.json

# Python / uv (backend)
backend/.venv/
**/__pycache__/
*.pyc
backend/db/*.db
backend/db/*.db-*

# Node (frontend)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Mídia processada em runtime (seção 10.1 do documento: fora do git) —
# ignora todo o conteúdo mas preserva a estrutura de pastas via .gitkeep
media/**
!media/**/
!media/**/.gitkeep

# Segredos
.env
.env.local
.env.*.local

# Sandbox de teste do harness Anime4K (teste/) — mídia local e log de telemetria
frontend/test/*.mp4
frontend/test/*.ndjson

# Backup do vídeo de entrada original, pré-reencode (hero da Inicio.jsx)
frontend/src/assets/video_entrada.original.mp4

# Vídeos locais catalogados sem captura/backend (paginas/Galeria.jsx, seção
# "Vídeos locais" — servidos estáticos por Vite via public/, nunca commitados)
frontend/public/videos-locais/*.mp4
